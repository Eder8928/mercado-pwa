rules_version = '2';
// Minha Lista de Mercado — LIVREZON TECNOLOGIA
// Autor: Eder Rodrigues — LIVREZON TECNOLOGIA
// Regras do Cloud Firestore (v3 — contas Google, família e Premium).
// Princípios: negar por padrão; cada família só vê os próprios dados; o usuário nunca
// altera plano/assinatura; formato e tamanho de todo documento são validados.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- funções ----------
    function signedIn() { return request.auth != null; }
    function isGoogle() {
      return signedIn()
        && request.auth.token.firebase.identities.keys().hasAny(['google.com'])
        && request.auth.token.email_verified == true;
    }
    function isMaster() {
      return isGoogle() && request.auth.token.email in ['ti.ederrodrigues@gmail.com'];
    }
    function hh(hid) { return get(/databases/$(database)/documents/households/$(hid)).data; }
    function isMember(hid) {
      return isGoogle() && request.auth.uid in hh(hid).members;
    }
    function isOwner(hid) { return isGoogle() && hh(hid).ownerUid == request.auth.uid; }
    function premium(h) { return 'plan' in h && h.plan == 'premium' && h.planUntil > request.time; }
    function str(v, max) { return v is string && v.size() <= max; }
    function num(v, max) { return (v is int || v is float) && v >= 0 && v <= max; }
    function chatOk(hid) { return isMember(hid) && (premium(hh(hid)) || isMaster()); }
    function geo(v, lim) { return (v is int || v is float) && v >= -lim && v <= lim; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------- lista compartilhada por link (v2) ----------
    function okList(d) {
      return d.keys().hasOnly(['v','name','budget','entries','done','total','doneBy','store','ownerUid','createdAt','updatedAt','expireAt'])
        && str(d.name, 80)
        && d.entries is map && d.entries.size() <= 400
        && (!('budget' in d) || num(d.budget, 1000000))
        && (!('total' in d) || num(d.total, 10000000))
        && (!('expireAt' in d) || d.expireAt is timestamp)
        && (!('doneBy' in d) || str(d.doneBy, 40))
        && (!('store' in d) || str(d.store, 80));
    }
    match /lists/{listId} {
      allow get: if signedIn();
      allow list: if isMaster();
      allow create: if (isMaster() && okList(request.resource.data)) || (signedIn()
        && listId.size() >= 20 && listId.size() <= 40
        && okList(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid);
      allow update: if (isMaster() && okList(request.resource.data)) || (signedIn()
        && okList(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isMaster() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // ---------- perfil do usuário ----------
    match /users/{uid} {
      allow get: if (isGoogle() && request.auth.uid == uid) || isMaster();
      allow list: if isMaster();
      allow create, update: if isGoogle() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','name','householdId','updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && str(request.resource.data.name, 40)
        && (request.resource.data.householdId == null
            || (request.resource.data.householdId is string
                && request.auth.uid in hh(request.resource.data.householdId).members));
      allow delete: if isGoogle() && request.auth.uid == uid;
      allow create, update, delete: if isMaster();   // restauração do Master Backup
    }

    // ---------- família (household) ----------
    match /households/{hid} {
      allow get: if isMember(hid) || isMaster();
      allow list: if isMaster();

      // cria a própria família: id = uid do dono, só ele como membro, sem plano
      allow create: if isGoogle() && hid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid','members','name','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == true
        && str(request.resource.data.name, 60)
        && request.resource.data.createdAt == request.time;

      allow update: if
        // dono: renomeia ou remove membros (nunca a si mesmo, nunca o plano)
        (isOwner(hid)
          && changed().hasOnly(['name','members'])
          && str(request.resource.data.name, 60)
          && request.resource.data.members.keys().hasAll([request.auth.uid])
          && resource.data.members.keys().hasAll(request.resource.data.members.keys()))
        // convidado: entra adicionando SOMENTE a si mesmo, com convite válido
        || (isGoogle()
          && !(request.auth.uid in resource.data.members)
          && changed().hasOnly(['members','lastInvite'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members[request.auth.uid] == true
          && resource.data.members.size() < 6
          && exists(/databases/$(database)/documents/households/$(hid)/invites/$(request.resource.data.lastInvite))
          && get(/databases/$(database)/documents/households/$(hid)/invites/$(request.resource.data.lastInvite)).data.expiresAt > request.time)
        // membro (não dono): sai removendo SOMENTE a si mesmo
        || (isMember(hid)
          && resource.data.ownerUid != request.auth.uid
          && changed().hasOnly(['members'])
          && resource.data.members.diff(request.resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.members))
        // Master/servidor de pagamentos: só plano
        || isMaster();   // plano/assinatura e restauração (toda ação do Master vai para a auditoria)

      allow delete: if isOwner(hid) || isMaster();
      allow create: if isMaster();                  // restauração do Master Backup

      // convites: só o dono de família Premium cria; qualquer conta Google lê pelo código (não lista)
      match /invites/{code} {
        allow get: if isGoogle();
        allow list: if isOwner(hid);
        allow create: if isOwner(hid) && premium(hh(hid))
          && code.size() >= 20 && code.size() <= 40
          && request.resource.data.keys().hasOnly(['expiresAt','createdAt'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt <= request.time + duration.value(2, 'd');
        allow delete: if isOwner(hid) || isMaster();
      }

      // itens cadastrados
      match /items/{itemId} {
        allow read, write: if isMaster();
        allow read: if isMember(hid);
        allow delete: if isMember(hid);
        allow create, update: if isMember(hid) && itemId.size() <= 40
          && request.resource.data.keys().hasOnly(['name','cat','unit','price','min','stock','barcode','t','by'])
          && str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
          && str(request.resource.data.cat, 40) && str(request.resource.data.unit, 12)
          && num(request.resource.data.price, 1000000)
          && num(request.resource.data.min, 100000) && num(request.resource.data.stock, 100000)
          && str(request.resource.data.barcode, 40)
          && request.resource.data.t is int && request.resource.data.by == request.auth.uid;
      }

      // histórico de compras
      match /history/{hId} {
        allow read, write: if isMaster();
        allow read: if isMember(hid);
        allow delete: if isMember(hid);
        allow create, update: if isMember(hid) && hId.size() <= 40
          && request.resource.data.keys().hasOnly(['date','store','listName','budget','total','refTotal','missing','by','entries','t','uid'])
          && request.resource.data.date is int
          && str(request.resource.data.store, 80) && str(request.resource.data.listName, 80)
          && num(request.resource.data.total, 10000000) && num(request.resource.data.refTotal, 10000000)
          && num(request.resource.data.budget, 10000000)
          && request.resource.data.entries is list && request.resource.data.entries.size() <= 400
          && request.resource.data.t is int && request.resource.data.uid == request.auth.uid;
      }

      // chat da família (Premium ou Master) — mensagens somem em 7 dias
      match /chat/{msgId} {
        allow read: if chatOk(hid);
        allow create: if chatOk(hid) && msgId.size() <= 40
          && request.resource.data.keys().hasOnly(['uid','name','kind','text','sector','lat','lng','acc','at'])
          && request.resource.data.uid == request.auth.uid
          && str(request.resource.data.name, 30)
          && request.resource.data.kind in ['text','sector','loc']
          && str(request.resource.data.text, 500) && str(request.resource.data.sector, 40)
          && (!('lat' in request.resource.data) || (geo(request.resource.data.lat, 90) && geo(request.resource.data.lng, 180) && num(request.resource.data.acc, 100000)))
          && request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if isMember(hid) && (resource.data.uid == request.auth.uid || isOwner(hid)
          || resource.data.at < request.time - duration.value(7, 'd'));
      }
      // onde cada membro está (setor do mercado)
      match /presence/{uid} {
        allow read: if chatOk(hid);
        allow create, update: if chatOk(hid) && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name','sector','at'])
          && str(request.resource.data.name, 30) && str(request.resource.data.sector, 40)
          && request.resource.data.at == request.time;
        allow delete: if isMember(hid) && (uid == request.auth.uid || isOwner(hid));
      }

      // categorias e preferências da família
      match /meta/{docId} {
        allow read, write: if isMaster();
        allow read: if isMember(hid);
        allow write: if isMember(hid) && docId == 'main'
          && request.resource.data.keys().hasOnly(['cats','t','by'])
          && request.resource.data.cats is list && request.resource.data.cats.size() <= 40
          && request.resource.data.t is int && request.resource.data.by == request.auth.uid;
      }
    }

    // ---------- configuração remota e auditoria (Master) ----------
    match /config/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if isMaster();
    }
    match /audit/{entryId} {
      allow read: if isMaster();
      allow create: if isMaster()
        && request.resource.data.keys().hasOnly(['at','email','action','target','reason','details'])
        && request.resource.data.email == request.auth.token.email
        && str(request.resource.data.reason, 300) && request.resource.data.reason.size() >= 3
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ---------- todo o resto: negado ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
