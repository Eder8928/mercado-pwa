rules_version = '2';
// Minha Lista de Mercado — LIVREZON TECNOLOGIA
// Autor: Eder Rodrigues — LIVREZON TECNOLOGIA
// Regras do Cloud Firestore.
//  - lists/{id}: lista compartilhada. Acesso só por quem conhece o código (não dá para listar),
//    formato e tamanho limitados, exclusão apenas por quem criou ou pelo Master.
//  - config/app: aviso global, modo manutenção e versão mínima (leitura pública, escrita só Master).
//  - audit/{id}: log de auditoria do Master, imutável (sem update/delete).
service cloud.firestore {
  match /databases/{database}/documents {

    // >>> E-mail(s) da conta Google do Acesso Master <<<
    function isMaster() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['MASTER_EMAIL_AQUI'];
    }
    function signedIn() { return request.auth != null; }

    function okShape(d) {
      return d.keys().hasOnly(['v','name','budget','entries','done','total','doneBy','store','ownerUid','createdAt','updatedAt','expireAt'])
        && d.name is string && d.name.size() <= 80
        && d.entries is map && d.entries.size() <= 400
        && (!('expireAt' in d) || d.expireAt is timestamp)
        && (!('doneBy' in d) || (d.doneBy is string && d.doneBy.size() <= 40))
        && (!('store' in d) || (d.store is string && d.store.size() <= 80));
    }

    match /lists/{listId} {
      allow get: if signedIn();
      allow list: if isMaster();
      allow create: if (isMaster() && okShape(request.resource.data)) || signedIn()
        && listId.size() >= 20 && listId.size() <= 40
        && okShape(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isMaster() && okShape(request.resource.data)) || (signedIn()
        && okShape(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isMaster() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /config/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if isMaster();
    }

    match /audit/{entryId} {
      allow read: if isMaster();
      allow create: if isMaster()
        && request.resource.data.keys().hasOnly(['at','email','action','target','reason','details'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 3
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
