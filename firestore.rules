rules_version = '2';
// Regras do banco da lista compartilhada (Minha Lista de Mercado).
// - Só quem está autenticado (login anônimo do app) acessa.
// - Uma lista só pode ser lida por quem sabe o código dela (não dá para listar/procurar listas).
// - Ninguém apaga listas pelo app; o formato e o tamanho dos dados são limitados.
service cloud.firestore {
  match /databases/{database}/documents {
    function okShape(d) {
      return d.keys().hasOnly(['v','name','budget','entries','done','total','doneBy','store','createdAt','updatedAt'])
        && d.name is string && d.name.size() <= 80
        && d.entries is map && d.entries.size() <= 400;
    }
    match /lists/{listId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && listId.size() >= 20 && listId.size() <= 40 && okShape(request.resource.data);
      allow update: if request.auth != null && okShape(request.resource.data);
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
